{
	"name": "wordpress-theme-starter-pack",
	"version": "2.0.0",
	"description": "A starter pack for create a new Wordpress Theme based on Tailwind, Vite and Docker",
	"scripts": {
		"start": "docker compose up -d && vite",
		"rebuild": "rm -rf node_modules dist && yarn install && yarn build",
		"dev": "vite",
		"build": "vite build",
		"serve": "vite preview"
	},
	"repository": {
		"type": "git",
		"url": "git+https://axiostudio@github.com/axiostudio/wordpress-theme-starter-pack.git"
	},
	"author": "axiostudio",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/axiostudio/wordpress-theme-starter-pack/issues"
	},
	"homepage": "https://github.com/axiostudio/wordpress-theme-starter-pack#readme",
	"dependencies": {},
	"devDependencies": {
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.49",
		"sass": "^1.81.0",
		"tailwindcss": "^3.4.15",
		"vite": "^5.4.11"
	}
}
