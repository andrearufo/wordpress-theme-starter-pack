	"dependencies": {},
	"devDependencies": {
		"autoprefixer": "^10.4.20",
		"dotenv": "^16.4.5",
		"postcss": "^8.4.49",
		"sass": "^1.81.0",
		"tailwindcss": "^3.4.15",
		"vite": "^5.4.11",
		"vite-plugin-full-reload": "^1.2.0"
	}
