{
	"name": "wordpress-theme-starter-pack",
	"version": "1.0.0",
	"description": "A starter pack for create a new Wordpress Theme based on Bootstrap 5, Mix and Docker",
	"scripts": {
		"start": "docker compose up -d && npx mix watch",
		"stop": "docker compose down",
		"watch": "npx mix watch",
		"build": "npx mix --production",
		"hot": "npx mix watch --hot"
	},
	"repository": {
		"type": "git",
		"url": "git+https://axiostudio@github.com/axiostudio/wordpress-theme-starter-pack.git"
	},
	"author": "axiostudio",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/axiostudio/wordpress-theme-starter-pack/issues"
	},
	"homepage": "https://github.com/axiostudio/wordpress-theme-starter-pack#readme",
	"devDependencies": {
		"@babel/core": "^7.20.2",
		"@babel/plugin-proposal-object-rest-spread": "^7.20.2",
		"@babel/plugin-syntax-dynamic-import": "^7.8.3",
		"@babel/plugin-transform-runtime": "^7.19.6",
		"@babel/preset-env": "^7.20.2",
		"@popperjs/core": "^2.11.6",
		"bootstrap": "^5.2.2",
		"browser-sync": "^2.27.10",
		"browser-sync-webpack-plugin": "^2.3.0",
		"jquery": "^3.6.1",
		"laravel-mix": "^6.0.49",
		"postcss": "^8.4.18",
		"resolve-url-loader": "^5.0.0",
		"sass": "^1.56.0",
		"sass-loader": "^13.1.0",
		"webpack": "^5.74.0",
		"webpack-cli": "^4.10.0"
	}
}
