{
	"name": "wordpress-theme-starter-pack",
	"version": "1.0.0",
	"description": "A starter pack for create a new Wordpress Theme based on Bootstrap 5, Mix and Docker",
	"scripts": {
		"start": "docker compose up -d && gulp",
		"rebuild": "rm -rf node_modules dist && yarn install && yarn build",
		"dev": "gulp",
		"build": "gulp build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://axiostudio@github.com/axiostudio/wordpress-theme-starter-pack.git"
	},
	"author": "axiostudio",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/axiostudio/wordpress-theme-starter-pack/issues"
	},
	"homepage": "https://github.com/axiostudio/wordpress-theme-starter-pack#readme",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "^5.3.2"
	},
	"devDependencies": {
		"browser-sync": "^3.0.2",
		"dotenv": "^16.4.5",
		"gulp": "^4.0.2",
		"gulp-autoprefixer": "^9.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-sass": "^5.1.0",
		"gulp-terser": "^2.1.0",
		"sass": "^1.71.0"
	}
}
