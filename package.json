{
	"name": "wordpress-theme-starter-pack",
	"version": "2.0.0",
	"description": "A starter pack for create a new Wordpress Theme based on Tailwind, Vite and Docker",
	"scripts": {
		"docker:start": "docker compose up -d",
		"docker:stop": "docker compose down",
		"dev": "docker compose up -d && vite",
		"serve": "docker compose up -d && vite preview",
		"build": "vite build"
	},
